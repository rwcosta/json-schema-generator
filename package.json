{
  "name": "json-schema-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "ajv": "^8.17.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
